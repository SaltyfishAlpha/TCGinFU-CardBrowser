{
  "name": "tcginfu-card-browser",
  "version": "0.2.0",
  "private": true,
  "description": "TCGinFU 卡牌浏览器：把 StreamingAssets/Content 里的 json + lua 拼成策划能直接读的卡牌目录，并做一致性检查。",
  "type": "commonjs",
  "bin": {
    "tcginfu-cards": "build.js"
  },
  "scripts": {
    "build": "node build.js",
    "open": "node build.js --open",
    "watch": "node build.js --watch",
    "serve": "node build.js --serve --open",
    "check": "node build.js --check",
    "test": "node --test test/*.test.js",
    "release": "node scripts/release.js"
  },
  "engines": {
    "node": ">=18"
  }
}
